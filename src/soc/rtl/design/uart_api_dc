`timescale 1ns / 1ps

module uart_api_dc
#(parameter DAC_WIDTH=16,
     parameter CYCLE_WIDTH=30,
     parameter DAC_CHANNEL=24,
     parameter CHANNEL_MES_WIDTH=96,
     parameter STREAM_ITER_WIDTH=10,
     parameter CORE_ITER_WIDTH=10,
     parameter DEPTH=20,
     parameter INSN_WIDTH=DAC_WIDTH*2+CORE_ITER_WIDTH+CYCLE_WIDTH,
     parameter TOTAL_REGS=DEPTH*3+2)
     (input  logic i_clk, i_rst,

     input  logic i_rx,
     output logic o_tx,

     input  logic i_trigger,
     
     output logic o_sclk,
     output logic o_mosi,
     output logic [DAC_CHANNEL-1:0]o_cs_n,
     output logic o_ldac_n);

    logic w_deq_rxq, w_rxq_empty;
    logic [7:0] w_rxq_data;
    
    localparam NUM_BYTES = INSN_WIDTH / 8;
    localparam FRAME_BYTES = 62 * 4; 
    uart #(
        .DATA_WIDTH(8),
        .RX_FIFO_DEPTH(100),
        .RX_FIFO_AF_DEPTH(16),
        .RX_FIFO_AE_DEPTH(4),
        .TX_FIFO_DEPTH(20),
        .TX_FIFO_AF_DEPTH(16),
        .TX_FIFO_AE_DEPTH(4)
    ) U (
        .i_clk(i_clk),
        .i_rst(!i_rst),
        .i_rx(i_rx),
        .o_tx(o_tx),
        .i_deq_rxq(w_deq_rxq),
        .o_rxq_data(w_rxq_data),
        .o_rxq_empty(w_rxq_empty),
        /* verilator lint_off PINCONNECTEMPTY */
        .o_rxq_ae(),
        .o_rxq_full(),
        .o_rxq_af(),
        .i_enq_txq(),
        .i_txq_data(),
        .o_txq_empty(),
        .o_txq_ae(),
        .o_txq_full(),
        .o_txq_af()
    );

    logic [7:0] fifo_din;
    logic fifo_enq, fifo_deq;
    logic [7:0] fifo_dout;
    logic fifo_full, fifo_empty;
    logic [15:0] r_byte_cnt;
    logic frame_ready;


    fifo #(
        .WIDTH(8),
        .DEPTH(256),
        .AF_DEPTH(240),
        .AE_DEPTH(8)
    ) u_uart_fifo (
        .i_clk(i_clk),
        .i_rst(i_rst),
        .i_data(w_rxq_data),
        .i_enq(!w_rxq_empty),  
        .i_deq(w_fifo_deq),
        .o_data(w_fifo_dout),
        .o_full(),
        .o_empty(w_fifo_empty),
        .o_almost_full(),
        .o_almost_empty()
    );

    logic [7:0]  w_fifo_dout;
    logic        w_fifo_deq;
    logic [31:0] r_word_accum;
    logic [5:0]  word_index;
    logic [1:0]  byte_in_word;
    
    logic [4:0]  r_channel_id;

    
    genvar i;
    generate
        for (i = 0; i < DAC_CHANNEL; i++) begin : GEN_DC
            dc #(
                .DAC_WIDTH(DAC_WIDTH),
                .CYCLE_WIDTH(CYCLE_WIDTH),
                .STREAM_ITER_WIDTH(STREAM_ITER_WIDTH),
                .CORE_ITER_WIDTH(CORE_ITER_WIDTH),
                .DEPTH(DEPTH)
            ) u_dc (
                .i_clk(i_clk),
                .i_rst(i_rst),
                .i_regs(r_dc_regs[i]),
                .i_start(r_start[i]),
                .o_armed(w_armed[i]),
                .o_sclk(o_sclk),
                .o_mosi(o_mosi),
                .o_cs_n(o_cs_n[i]),
                .o_ldac_n(o_ldac_n)
            );
        end
    endgenerate

    logic [15:0] r_byte_cnt;
    logic frame_ready;

    always_ff @(posedge i_clk or negedge i_rst) begin
        if (!i_rst) begin
            r_byte_cnt  <= 1'b0;
            frame_ready <= 1'b0;
        end else begin
            frame_ready <= 1'b0;
            if (!w_rxq_empty && !u_uart_fifo.o_full)
                r_byte_cnt <= r_byte_cnt + 1;
            if (r_byte_cnt == FRAME_BYTES) begin
                frame_ready <= 1'b1;
                r_byte_cnt  <= 0;
            end
        end
    end


    typedef enum logic [1:0] {IDLE, READ_FRAME, WRITE_DONE} state_t;
    state_t r_state;

    always_ff @(posedge i_clk or negedge i_rst) begin
        if (!i_rst) begin
            r_state <= IDLE;
            w_fifo_deq <= 0;
            word_index <= 0;
            byte_in_word <= 0;
        end else begin
            w_fifo_deq <= 0;

            case (r_state)
            IDLE: begin
                if (frame_ready) begin
                    r_state <= READ_FRAME;
                    word_index <= 0;
                    byte_in_word <= 0;
                    w_fifo_deq <= 1;
                end
            end

            READ_FRAME: begin
                if (!w_fifo_empty) begin
                    w_fifo_deq <= 1;
                    r_word_accum <= {w_fifo_dout, r_word_accum[31:8]};
                    byte_in_word <= byte_in_word + 1;
                    if (byte_in_word == 2'b11) begin  // 4bit word
                        r_ch_regs[r_channel_id][word_index] <= r_word_accum;
                        word_index <= word_index + 1;
                        if (word_index == 6'd61) begin
                            r_state <= WRITE_DONE;
                            w_fifo_deq <= 0;
                        end
                    end
                end
            end

            WRITE_DONE: begin
                // 62*32bit后，dc_stream
                r_ch_regs[r_channel_id][61] <= 32'h0;  // new_stream trigger
                r_state <= IDLE;
            end
            endcase
        end
    end

endmodule
